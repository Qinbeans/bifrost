let http = import("http")
let mem = import("std:mem")
let state = import("http.state:state")
let add = import("http.api.add:api")
let handlers = import("http_server.handlers:handlers")
let hello = import("http.api.hello:api")
let echo = import("http.api.echo:api")
let hits = import("http.api.hits:api")
let slow = import("http.api.slow:api")
let users = import("http.api.users:api")
let notes = import("http.api.notes:api")

let main = [
    http.app,
    http.get,
    http.post,
    http.get_with,
    http.run_with,
    handlers.health,
    hello.hello,
    add.add,
    echo.echo,
    hits.hits,
    slow.slow,
    users.users,
    notes.add,
    notes.list,
    http.post_with
] () => i32 {
    let app = http.app()
    http.get(app, "/health", handlers.health)
    http.get(app, "/hello/:name", hello.hello)
    http.get(app, "/add", add.add)
    http.post(app, "/echo", echo.echo)
    http.get_with(app, "/hits", hits.hits)
    http.get(app, "/slow", slow.slow)
    http.get(app, "/users", users.users)
    http.post_with(app, "/notes", notes.add)
    http.get_with(app, "/notes", notes.list)

    let shared: mem.Shared[state.AppState] = state.AppState(hits: 0, notes: #[])
    return http.run_with(app, 8080, shared)
}
